# Frontend (safe to expose; Vite inlines these into the build)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=paste-the-anon-or-publishable-key
# Cloudflare's always-pass test key for local development. Replace in production.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
VITE_SITE_URL=http://localhost:5173

# Server only. Set these as Supabase Edge Function secrets, never in frontend code.
# Locally they go in supabase/functions/.env (gitignored).
# SUPABASE_SERVICE_ROLE_KEY is provided to functions automatically by Supabase.
RESEND_API_KEY=
EMAIL_FROM=Seedline <hello@yourdomain.com>
# Cloudflare's always-pass test secret for local development. Replace in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
CHECKIN_SIGNING_SECRET=generate-with-openssl-rand-hex-32
SITE_URL=http://localhost:5173
CRON_SECRET=generate-with-openssl-rand-hex-32
