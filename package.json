{
  "name": "seedline",
  "version": "1.0.0",
  "description": "Seedline: find non-dilutive funding and programs, in order.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && tsx scripts/build-headers.ts",
    "preview": "wrangler pages dev dist --port 8788",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "contrast": "tsx scripts/contrast.ts",
    "check:copy": "tsx scripts/check-copy.ts"
  },
  "type": "module",
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0"
  }
}
